<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendarFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.machines.CalendarFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!--Machine list -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Machine List"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerMachine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp" />

            <ImageView
                android:id="@+id/imageMachine"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="Selected machine picture"
                android:scaleType="fitCenter"
                android:src="@drawable/cnc_machine_1"
                tools:src="@drawable/cnc_machine_1" />

            <TextView
                android:id="@+id/txtMachineName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="CNC MachineX"
                android:textSize="18sp"
                android:textStyle="bold" />
            <!-- Calendar -->
            <CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/txtSelectedDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Select a date"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editMemo"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:gravity="top|start"
                android:hint="Enter maintenance memo"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="2000"
                android:padding="12dp"
                android:scrollbars="vertical"
                tools:ignore="Autofill" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDeleteMemo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="Delete" />

                <Button
                    android:id="@+id/btnSaveMemo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Save memo" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>